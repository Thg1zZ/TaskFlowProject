# ==========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ==========================================
DB_URL=jdbc:postgresql://<host>:<porta>/<database>?sslmode=require
DB_USER=<usuario-do-banco>
DB_PASSWORD=<senha-do-banco>

# ==========================================
# CONFIGURAÇÕES DA APLICAÇÃO (BACKEND)
# ==========================================
# Gere com: openssl rand -base64 48
JWT_SECRET=<segredo-com-no-minimo-32-caracteres>
JPA_DDL_AUTO=update

# ==========================================
# E-MAIL (recuperação de senha)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<seu-email>@gmail.com
# Senha de app do Google (não é a senha da conta)
MAIL_PASSWORD=<senha-de-app>
# Opcional: remetente exibido (padrão: MAIL_USERNAME)
MAIL_FROM=

# ==========================================
# INTEGRAÇÃO FRONTEND
# ==========================================
# URL do frontend (sem a barra final) — usada no link do e-mail de redefinição
FRONTEND_URL=https://<seu-frontend>.vercel.app
CORS_ORIGINS=https://<seu-frontend>.vercel.app
GOOGLE_CLIENT_ID=<seu-client-id>.apps.googleusercontent.com
