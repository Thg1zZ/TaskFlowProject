# ==========================================
# CONFIGURAÇÕES DO BANCO DE DADOS (SUPABASE)
# ==========================================
DB_URL=jdbc:postgresql://DB_HOST_PLACEHOLDER:6543/postgres?sslmode=require
DB_USER=DB_USER_PLACEHOLDER
DB_PASSWORD=SUA_SENHA_AQUI_DO_SUPABASE

# ==========================================
# CONFIGURAÇÕES DA APLICAÇÃO (BACKEND)
# ==========================================
# Crie uma senha muito longa e aleatória (ex: MudarParaProducaoASVS42026!@#)
JWT_SECRET=JWT_SECRET_PLACEHOLDER
JPA_DDL_AUTO=update

# ==========================================
# INTEGRAÇÃO FRONTEND
# ==========================================
# A URL do seu site no Vercel (SEM a barra final)
CORS_ORIGINS=https://task-manager-with-login.vercel.app
GOOGLE_CLIENT_ID=998805737602-bn3djirobk8duvelb097be3pt0g03iqu.apps.googleusercontent.com
